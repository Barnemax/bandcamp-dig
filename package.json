{
  "name": "bandcamp-dig",
  "type": "module",
  "version": "1.1.2",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "description": "Dig better on Bandcamp. Sort items in playlists, track new releases, provide dark mode and more.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "lint:css": "stylelint \"src/**/*.scss\" \"public/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.scss\" \"public/**/*.css\" --fix",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "pako": "^3.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@barnemax/bandcamp-types": "^0.1.5",
    "eslint": "^10.13.0",
    "sass": "^1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
